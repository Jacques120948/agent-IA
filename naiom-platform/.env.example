# ================== CLÉ OBLIGATOIRE ==================
# Ta clé API Anthropic (Claude) — https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=

# ============== AGENT ACTIF ==============
# Ce dépôt contient DEUX agents : `createur-contenu` (Léa) et `ecommerce` (Emma).
# L'app n'en débloque qu'un à la fois — change ces deux lignes pour basculer,
# puis relance `npm run dev`.
OWNED_AGENT=createur-contenu
NEXT_PUBLIC_OWNED_AGENT=createur-contenu

# ============== OPTIONNEL ==============
# Lien pour "débloquer" les autres agents (email ou page de vente)
NEXT_PUBLIC_UNLOCK_URL=
# Clés selon les fonctionnalités de cet agent :
# Léa : aucune clé en plus — Claude suffit.
# Emma : connexion Arcads directement dans l'app.
# APIFY_TOKEN=            # scraping (prospection / veille)
# GEMINI_API_KEY=         # images (designer)
# FIREFLIES_API_KEY=      # analyse de calls
# GOOGLE_CLIENT_ID=       # Gmail / Google
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
